<a
  class="back"
  id="backButton"
  href="{% if itineraires.title === 'itinéraire' %}../../itineraires/index.html
        {% elif destinations.title === 'France' %}../../france/index.html#{{
    destinations.name | slugify
  }}
        {% elif destinations.title === 'international' %}../../international/index.html#{{
    destinations.name | slugify
  }}
        {% elif destinations.title === 'Québec' %}../../quebec/index.html#{{
    destinations.name | slugify
  }}
        {% else %}#{% endif %}"
  data-default-href="{% if itineraires.title === 'itinéraire' %}../../itineraires/index.html
        {% elif destinations.title === 'France' %}../../france/index.html#{{
    destinations.name | slugify
  }}
        {% elif destinations.title === 'international' %}../../international/index.html#{{
    destinations.name | slugify
  }}
        {% elif destinations.title === 'Québec' %}../../quebec/index.html#{{
    destinations.name | slugify
  }}
        {% else %}#{% endif %}"
  title="retour vers {{ destinations.title }}{{ itineraires.title }}{{
    departements.title
  }}{{ regions.title }}{{ pays.title }}"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    fill="currentColor"
    class="bi bi-caret-left-fill"
    viewBox="0 0 16 16"
  >
    <path
      d="m3.86 8.753 5.482 4.796c.646.566 1.658.106 1.658-.753V3.204a1 1 0 0 0-1.659-.753l-5.48 4.796a1 1 0 0 0 0 1.506z"
/>
  </svg>
</a>